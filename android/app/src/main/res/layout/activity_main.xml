<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Top App Bar Chrome - Sleek Minimal Address Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Single Omnibox Search / Address Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_omnibox"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <!-- Server Status Dot (subtle network status indicator) -->
            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@color/accent_emerald" />

            <!-- Protocol Badge -->
            <TextView
                android:id="@+id/protocol_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fetch://"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Omnibox Input -->
            <EditText
                android:id="@+id/omnibox_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/omnibox_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- Clear Action -->
            <ImageView
                android:id="@+id/btn_clear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/text_muted" />

            <!-- Go / Navigate Action -->
            <ImageView
                android:id="@+id/btn_go"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/primary_light" />
        </LinearLayout>

        <!-- Dynamic Loading Line -->
        <ProgressBar
            android:id="@+id/loading_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent_cyan"
            android:visibility="invisible" />

        <!-- Hidden views to preserve ViewBinding backward-compatibility -->
        <View
            android:id="@+id/btn_brand"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_p2p_drop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- WebView Container (Direct touch - no swipe-to-refresh interference) -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_base"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Dynamic WebViews are attached here per tab -->

        <!-- Offline / Error Overlay -->
        <LinearLayout
            android:id="@+id/error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/status_error" />

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Site Not Reachable"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Unable to connect to Neo server or resolve site."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/primary"
                android:text="Retry"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Fullscreen Video Container -->
        <FrameLayout
            android:id="@+id/fullscreen_custom_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Navigation Bar Chrome -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_muted" />

        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_muted" />

        <!-- NeoSearch Home Button -->
        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/primary_light" />

        <!-- Bookmarks Sheet Button -->
        <ImageButton
            android:id="@+id/btn_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmarks"
            android:src="@android:drawable/btn_star"
            app:tint="@color/text_muted" />

        <!-- Tabs Switcher Badge Button -->
        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_count_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_accent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- More / Downloads Menu -->
        <ImageButton
            android:id="@+id/btn_downloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Downloads"
            android:src="@android:drawable/stat_sys_download_done"
            android:visibility="gone"
            app:tint="@color/text_muted" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
