<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_bg">

    <!-- Chrome Top App Bar Container (gets dynamic status bar + cutout insets in Kotlin) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chrome_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Bar Content Row (Height 56dp) -->
        <LinearLayout
            android:id="@+id/toolbar_content_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Chrome Omnibox Capsule / Pill -->
            <LinearLayout
                android:id="@+id/omnibox_container"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chrome_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <!-- Security / Neo Badge Icon -->
                <ImageView
                    android:id="@+id/security_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/chrome_security_green" />

                <!-- Display Domain / Title (Browsing Mode) -->
                <TextView
                    android:id="@+id/omnibox_display_title"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="NeoSearch"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <!-- Input EditText (Editing Mode) -->
                <EditText
                    android:id="@+id/omnibox_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/chrome_icon_muted"
                    android:textSize="14sp" />

                <!-- Clear Text Button ('X') -->
                <ImageView
                    android:id="@+id/btn_clear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/chrome_icon_muted" />

                <!-- Refresh / Reload Button inside pill -->
                <ImageView
                    android:id="@+id/btn_refresh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/chrome_icon_muted" />

            </LinearLayout>

            <!-- Chrome Tab Switcher Button (Outside Pill) -->
            <FrameLayout
                android:id="@+id/btn_tabs_top"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_box">

                    <TextView
                        android:id="@+id/tab_count_top"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="1"
                        android:textColor="@color/chrome_icon"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <!-- Chrome 3-Dot More Menu Button -->
            <ImageView
                android:id="@+id/btn_more_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/chrome_icon" />

        </LinearLayout>

        <!-- Chrome Thin Horizontal Progress Bar -->
        <ProgressBar
            android:id="@+id/loading_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/chrome_accent"
            android:visibility="invisible" />

        <!-- Hidden views to preserve any legacy ViewBinding references -->
        <View android:id="@+id/status_dot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/protocol_badge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btn_go" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btn_brand" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btn_p2p_drop" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/status_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- Floating Find in Page Bar -->
    <LinearLayout
        android:id="@+id/find_in_page_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/chrome_surface_elevated"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <EditText
            android:id="@+id/find_query_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Find in page…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textColorHint="@color/chrome_icon_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/find_match_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="0/0"
            android:textColor="@color/chrome_icon_muted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btn_find_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:rotation="90"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/chrome_icon" />

        <ImageView
            android:id="@+id/btn_find_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:rotation="90"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/chrome_icon" />

        <ImageView
            android:id="@+id/btn_find_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/chrome_icon" />
    </LinearLayout>

    <!-- WebView Content Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/chrome_bg"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Offline / Error Overlay -->
        <LinearLayout
            android:id="@+id/error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/status_error" />

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Site Not Reachable"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Unable to connect to Neo server or resolve decentralized site."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="Try Again"
                android:textColor="#09090B"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fullscreen Video Container -->
        <FrameLayout
            android:id="@+id/fullscreen_custom_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Chrome-Style Bottom Navigation Bar (Gets dynamic navigation bar insets in Kotlin) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chrome_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Top Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/chrome_divider" />

        <!-- Bottom Actions Row (Height 52dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/chrome_icon" />

            <!-- Forward -->
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/chrome_icon" />

            <!-- Home -->
            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="@color/chrome_icon" />

            <!-- Bookmarks Star -->
            <ImageButton
                android:id="@+id/btn_bookmarks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bookmarks"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/chrome_icon" />

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share"
                android:src="@drawable/ic_share"
                app:tint="@color/chrome_icon" />

            <!-- Hidden legacy views -->
            <FrameLayout
                android:id="@+id/btn_tabs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tab_count_badge" android:layout_width="0dp" android:layout_height="0dp" />
            </FrameLayout>
            <ImageButton android:id="@+id/btn_downloads" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
